{
  "name": "lime-guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4173",
    "build": "node scripts/check-content.mjs && astro build && node scripts/check-build.mjs",
    "check": "node scripts/check-content.mjs && node --test scripts/checks.test.mjs",
    "translations:record": "node scripts/check-content.mjs --record",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "preview:stop": "astro preview stop",
    "dev:stop": "astro dev stop"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/starlight": "0.43.1",
    "@fontsource/noto-sans-myanmar": "5.3.0",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "cheerio": "1.1.2",
    "yaml": "2.9.1"
  }
}
